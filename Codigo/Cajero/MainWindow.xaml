<Window x:Class="CajeroRed.Cajero.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NETGEAR · Cajero" Width="1030" Height="790" MinWidth="800" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid Background="#163A82"><Border Margin="26" CornerRadius="12" Background="#F4F7FC">
  <DockPanel Margin="28">
   <Grid DockPanel.Dock="Top" Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="Banco" Text="NETGEAR" FontSize="27" FontWeight="Bold" Foreground="#163A82"/><TextBlock Text="CAJERO AUTOMÁTICO · RED FASE II" FontSize="11" Foreground="#53657F" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="Identidad" HorizontalAlignment="Right" FontWeight="SemiBold"/><TextBlock x:Name="Conexion" Text="Conectando…" Foreground="#A65E00" Margin="0,8,0,0"/></StackPanel></Grid>
   <StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,15,0,12"/><WrapPanel x:Name="Pie"/><TextBlock x:Name="Aviso" Text="Su seguridad es importante. No comparta su PIN." FontSize="12" Foreground="#53657F" Margin="4,8"/></StackPanel>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><ContentControl x:Name="Pantalla"/></ScrollViewer>
  </DockPanel>
 </Border></Grid>
</Window>
