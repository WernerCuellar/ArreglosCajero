<Window x:Class="CajeroRed.Servidor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="NETGEAR · Servidor" Width="1320" Height="850" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid Background="{StaticResource Fondo}">
  <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#163A82">
   <DockPanel Margin="15,24">
    <StackPanel DockPanel.Dock="Top"><TextBlock Text="NETGEAR" FontSize="25" FontWeight="Bold" Foreground="White"/><TextBlock Text="CENTRO DE CONTROL · FASE II" Foreground="#B5CFFF" FontSize="10" Margin="0,12,0,25"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="Una red. Un control central." Foreground="#B5CFFF" FontSize="11" Margin="4,12"/><TextBlock x:Name="UsuarioActual" Foreground="White" Margin="4,4"/></StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="Menu"/></ScrollViewer>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="1" Margin="28,22">
   <Border DockPanel.Dock="Top" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
    <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" x:Name="ControlesServicio"/><StackPanel><TextBlock x:Name="EstadoServidor" Text="Servicio detenido" FontWeight="SemiBold"/><TextBlock x:Name="Direcciones" FontSize="12" Foreground="#53657F" Margin="0,6,0,0"/></StackPanel></DockPanel>
   </Border>
   <TextBlock x:Name="EstadoPie" DockPanel.Dock="Bottom" Text="Inicie sesión para administrar la red." Foreground="#53657F" FontSize="12" Margin="0,12,0,0"/>
   <ContentControl x:Name="Contenido"/>
  </DockPanel>
 </Grid>
</Window>
